calculateSquare <- function(num)
{
  square <- num * num
  return(square)
}
value <- 8
answer <- calculateSquare(value)
cat("Square =", answer, "\n")
logicalVector <- c(TRUE, FALSE, TRUE, TRUE, FALSE)
andResult <- logicalVector & TRUE
orResult <- logicalVector | FALSE
notResult <- !logicalVector
countTrue <- sum(logicalVector)
cat("\nLogical Vector\n")
print(logicalVector)
cat("AND Result\n")
print(andResult)
cat("OR Result\n")
print(orResult)
cat("NOT Result\n")
print(notResult)
cat("Number of TRUE values =", countTrue, "\n")
