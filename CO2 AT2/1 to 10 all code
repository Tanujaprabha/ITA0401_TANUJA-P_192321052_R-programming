#10
data <- read.csv("D:/customer_data.csv")
cat("BUSINESS ANALYTICS REPORT\n\n")
cat("Mean Purchase Amount =",
    mean(data$Purchase_Amount), "\n")
cat("Median Purchase Amount =",
    median(data$Purchase_Amount), "\n")
cat("Standard Deviation =",
    sd(data$Purchase_Amount), "\n")
cat("Correlation =",
    cor(data$Monthly_Income,
        data$Purchase_Amount), "\n\n")
cat("T-Test\n")
ttest_result <- t.test(Purchase_Amount ~ Gender,
                       data = data)
print(ttest_result)
cat("\nANOVA\n")
anova_result <- aov(Customer_Rating ~ Store_Type,
                    data = data)
print(summary(anova_result))
cat("\nChi-Square Test\n")
chi_table <- table(data$Membership_Status,
                   data$Product_Category)
chi_result <- chisq.test(chi_table)
print(chi_result)
cat("\nReport Completed Successfully\n")
