data <- read.csv("D:/customer_data.csv")

mean_purchase <- mean(data$Purchase_Amount)
median_purchase <- median(data$Purchase_Amount)

mode_purchase <- names(sort(table(data$Purchase_Amount),
                            decreasing = TRUE))[1]

cat("Mean =", mean_purchase, "\n")
cat("Median =", median_purchase, "\n")
cat("Mode =", mode_purchase, "\n")
